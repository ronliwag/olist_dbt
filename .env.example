# Kaggle API Credentials
# Get these from https://www.kaggle.com/settings -> API -> Create New Token
KAGGLE_USERNAME="your-kaggle-username"
KAGGLE_KEY="your-kaggle-api-key"


# Database Credentials & Connections
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=olist-db
DB_PORT=5432
DB_NAME=olist
DB_RAW_DATA_TABLE=raw
DB_CLEANED_TABLE=cleaned

# Automatic Airflow Connection Creation
AIRFLOW_CONN_POSTGRES_DEFAULT="postgresql://postgres:postgres@olist-db:5432/olist"

# Paths (as seen inside the Airflow containers - defaults match the standard Astro CLI mount)
SPARK_JARS_PATH=/usr/local/airflow/include/jars/postgresql-42.7.12.jar
RAW_DATA_DIR=/usr/local/airflow/include/data/raw
